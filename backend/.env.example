# Shared backend settings. Use unique, strong secrets outside local development.

# Authentication service
AUTH_APP_ENV=development
AUTH_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/authentication
AUTH_JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_OTP_SECRET=replace-with-a-separate-random-secret
AUTH_CORS_ALLOW_ORIGINS=http://localhost:3000
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_USE_TLS=true
AUTH_PINECONE_API_KEY=
AUTH_PINECONE_INDEX_NAME=
AUTH_ORCHESTRATION_SERVICE_URL=http://127.0.0.1:8001
AUTH_ORCHESTRATION_SERVICE_TOKEN=
AUTH_FACE_MODEL_ROOT=./models

# Resume parsing and candidate matching service
ATS_APP_ENV=development
ATS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ats_parser_checker
ATS_CORS_ALLOWED_ORIGINS=http://localhost:3000
ATS_MODELS_DIR=./models
ATS_EMBEDDING_MODEL_DIR=./models/embedding
ATS_RERANKER_MODEL_DIR=./models/reranker
ATS_RESUME_SOURCE_DIR=./resumes
ATS_PINECONE_API_KEY=
ATS_PINECONE_INDEX_NAME=candidate-resumes
ATS_NEO4J_URI=
ATS_NEO4J_USERNAME=
ATS_NEO4J_PASSWORD=

# Orchestration service
ORCH_APP_ENV=development
ORCH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orchestration
ORCH_AUTH_JWT_SECRET_KEY=replace-with-the-same-auth-jwt-secret
ORCH_INTERNAL_SERVICE_TOKEN=
ORCH_AUTHENTICATION_SERVICE_URL=http://127.0.0.1:8000
ORCH_ATS_SERVICE_URL=http://127.0.0.1:8090
ORCH_ANTI_SPOOFING_SERVICE_URL=http://127.0.0.1:8080
ORCH_CANDIDATE_PORTAL_BASE_URL=http://localhost:3000
ORCH_CORS_ALLOWED_ORIGINS=http://localhost:3000
ORCH_STT_BACKEND=whisper
ORCH_STT_MODEL_DIR=./models/speech-recognition
ORCH_STT_DEVICE=cpu
ORCH_STT_COMPUTE_TYPE=int8
ORCH_AI_API_URL=
ORCH_AI_API_KEY=
ORCH_AI_DEPLOYMENT_ID=
ORCH_SMTP_HOST=
ORCH_SMTP_PORT=587
ORCH_SMTP_USERNAME=
ORCH_SMTP_PASSWORD=
ORCH_SMTP_FROM_EMAIL=

# Anti-spoofing and session verification service
ANTI_SPOOFING_APP_ENV=development
ANTI_SPOOFING_JWT_SECRET_KEY=replace-with-the-same-auth-jwt-secret
ANTI_SPOOFING_ALLOWED_ORIGINS=http://localhost:3000
ANTI_SPOOFING_MODELS_DIR=./models
ANTI_SPOOFING_SESSION_STORE_BACKEND=memory
ANTI_SPOOFING_REDIS_URL=redis://localhost:6379/0
ANTI_SPOOFING_STT_BACKEND=whisper
ANTI_SPOOFING_DEVICE=cpu
